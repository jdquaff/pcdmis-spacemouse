<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
  3DxWare 10 application profile for Hexagon PC-DMIS (PCDLRN.exe)
  https://github.com/jdquaff/pcdmis-spacemouse

  Install: copy this file to %APPDATA%\3Dconnexion\3DxWare\Cfg\ and restart
  the 3Dconnexion driver (or run install.ps1). See README.md.

  How it works: 3DxWare treats PC-DMIS as an unsupported program and only
  maps the cap to the scroll wheel. This profile instead turns each cap
  motion into the mouse gesture PC-DMIS already understands in the Graphic
  Display window (PC-DMIS default style, Translate mode):

    Middle-button drag ......... 3D rotate
    Alt + right-button drag .... 2D rotate (in the screen plane)
    Right-button drag .......... pan
    Mouse wheel ................ zoom

  Cap motion (object mode)     ->  PC-DMIS gesture
    Slide left/right   (X)     ->  right-drag, horizontal  (pan)
    Pull up/push down  (Z)     ->  right-drag, vertical    (pan)
    Pull/push fwd-back (Y)     ->  mouse wheel             (zoom)
    Tilt fwd/back      (Rx)    ->  middle-drag, vertical   (3D rotate)
    Spin               (Rz)    ->  middle-drag, horizontal (3D rotate)
    Roll left/right    (Ry)    ->  Alt + right-drag        (2D rotate)

  If a motion goes the wrong way, flip that axis's <Reversed> value.
  Key codes are USB HID usage IDs in hex (Z = 1D, F1 = 3A, P = 13).
  Nothing here starts execution or moves the CMM.
-->
<AppCfg Default="false" xmlns="" CfgFormatVersion="1.2" ThisFileVersion="1.0" xml:space="preserve">
  <AppInfo>
    <Signature>
      <Name>PC-DMIS</Name>
      <ExecutableName>PCDLRN.exe</ExecutableName>
      <Transport>KMJ</Transport>
    </Signature>
    <Options />
  </AppInfo>
  <CfgProperties>
    <InheritsFrom>STR_DEFAULT_KMJ</InheritsFrom>
    <Access />
  </CfgProperties>
  <Settings>
    <!-- Global speed multiplier. The speed slider in 3Dconnexion Settings
         adjusts the same thing; 0.50 = half speed, 2.00 = double. -->
    <OverallScale>1.00</OverallScale>
  </Settings>

  <!-- PC-DMIS keyboard shortcuts (PC-DMIS Help: Shortcut Keys Reference) -->
  <MacroTable>
    <MacroEntry>
      <!-- Ctrl+Z: Scale to Fit -->
      <ID>PC-DMIS Scale to Fit</ID>
      <KeyStroke>
        <Modifiers>
          <Modifier>Control</Modifier>
        </Modifiers>
        <Key>1D</Key>
      </KeyStroke>
    </MacroEntry>
    <MacroEntry>
      <!-- Ctrl+F1: Translate mode. Right-drag pans only in this mode. -->
      <ID>PC-DMIS Translate Mode</ID>
      <KeyStroke>
        <Modifiers>
          <Modifier>Control</Modifier>
        </Modifiers>
        <Key>3A</Key>
      </KeyStroke>
    </MacroEntry>
    <MacroEntry>
      <!-- Alt+P: draw the probe path for the whole routine (display only) -->
      <ID>PC-DMIS Draw Probe Path</ID>
      <KeyStroke>
        <Modifiers>
          <Modifier>Alt</Modifier>
        </Modifiers>
        <Key>13</Key>
      </KeyStroke>
    </MacroEntry>
  </MacroTable>

  <!-- Radial menu on the left button of a SpaceMouse Wireless
       (the Menu button on larger models). -->
  <Menus>
    <Executable>3DxPieMenus.exe</Executable>
    <Menu Type="Radial">
      <Name>PC-DMIS</Name>
      <ID>MenuRM_be77abb0-db47-4f95-85e3-a7c13838ba9d</ID>
      <GesturesEnabled>true</GesturesEnabled>
      <Style>EightButton</Style>
      <Button>
        <Input>
          <ActionID>MenuButton_1</ActionID>
        </Input>
        <Output>
          <ActionID>PC-DMIS Scale to Fit</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_2</ActionID>
        </Input>
        <Output>
          <ActionID>PC-DMIS Translate Mode</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_3</ActionID>
        </Input>
        <Output>
          <ActionID>PC-DMIS Draw Probe Path</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_4</ActionID>
        </Input>
        <Output>
          <ActionID>KB_Esc</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_5</ActionID>
        </Input>
        <Output>
          <ActionID>Driver_ToggleRotations</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_6</ActionID>
        </Input>
        <Output>
          <ActionID>Driver_ToggleTranslations</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_7</ActionID>
        </Input>
        <Output>
          <ActionID>Driver_ToggleDominantFilter</ActionID>
        </Output>
      </Button>
      <Button>
        <Input>
          <ActionID>MenuButton_8</ActionID>
        </Input>
        <Output>
          <ActionID>Driver_ShowDriverGUI</ActionID>
        </Output>
      </Button>
    </Menu>
  </Menus>
  <ButtonActions>
    <ButtonAction Type="Menu">
      <ID>RadialMenu_MenuRM_be77abb0-db47-4f95-85e3-a7c13838ba9d</ID>
      <Name>PC-DMIS</Name>
      <MenuID>MenuRM_be77abb0-db47-4f95-85e3-a7c13838ba9d</MenuID>
    </ButtonAction>
  </ButtonActions>

  <Devices>
    <!-- Applies to every 3Dconnexion 3D mouse. -->
    <Device>
      <Name>Standard 3D Mouse</Name>
      <VendorID>0</VendorID>
      <ProductID>0</ProductID>
      <InheritsFrom>Standard 3D Mouse</InheritsFrom>
      <!-- Dominant: only the strongest cap motion is sent at any moment, so
           pan (right button) and rotate (middle button) never press two
           mouse buttons at once. Toggle it from the radial menu. -->
      <AxisFilter>Dominant</AxisFilter>
      <CurrentButtonBank>Default</CurrentButtonBank>
      <AxisBank Default="true">
        <Name>STR_DEFAULT_BANK</Name>
        <ID>Default</ID>
        <!-- Pan left/right: right-button drag, horizontal -->
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_X</ActionID>
            <Min>-512</Min>
            <Max>511</Max>
            <Deadband>30</Deadband>
          </Input>
          <Output>
            <Modifiers>
              <Modifier>RightMouse</Modifier>
            </Modifiers>
            <Reversed>false</Reversed>
            <ActionID>HIDMouse_X</ActionID>
          </Output>
        </Axis>
        <!-- Pan up/down: right-button drag, vertical -->
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Z</ActionID>
            <Min>-512</Min>
            <Max>511</Max>
            <Deadband>30</Deadband>
          </Input>
          <Output>
            <Modifiers>
              <Modifier>RightMouse</Modifier>
            </Modifiers>
            <Reversed>false</Reversed>
            <ActionID>HIDMouse_Y</ActionID>
          </Output>
        </Axis>
        <!-- Zoom: mouse wheel -->
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Y</ActionID>
            <Min>-512</Min>
            <Max>511</Max>
            <Deadband>30</Deadband>
          </Input>
          <Output>
            <Reversed>false</Reversed>
            <ActionID>HIDMouse_Wheel</ActionID>
          </Output>
        </Axis>
        <!-- Tilt: middle-button drag, vertical (3D rotate) -->
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Rx</ActionID>
            <Min>-512</Min>
            <Max>511</Max>
            <Deadband>30</Deadband>
          </Input>
          <Output>
            <Modifiers>
              <Modifier>MiddleMouse</Modifier>
            </Modifiers>
            <Reversed>false</Reversed>
            <ActionID>HIDMouse_Y</ActionID>
          </Output>
        </Axis>
        <!-- Spin: middle-button drag, horizontal (3D rotate) -->
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Rz</ActionID>
            <Min>-512</Min>
            <Max>511</Max>
            <Deadband>30</Deadband>
          </Input>
          <Output>
            <Modifiers>
              <Modifier>MiddleMouse</Modifier>
            </Modifiers>
            <Reversed>true</Reversed>
            <ActionID>HIDMouse_X</ActionID>
          </Output>
        </Axis>
        <!-- Roll: Alt + right-button drag, horizontal (2D rotate) -->
        <Axis>
          <Enabled>true</Enabled>
          <Input>
            <ActionID>HIDMultiAxis_Ry</ActionID>
            <Min>-512</Min>
            <Max>511</Max>
            <Deadband>30</Deadband>
          </Input>
          <Output>
            <Modifiers>
              <Modifier>Alt</Modifier>
              <Modifier>RightMouse</Modifier>
            </Modifiers>
            <Reversed>false</Reversed>
            <ActionID>HIDMouse_X</ActionID>
          </Output>
        </Axis>
      </AxisBank>
      <!-- Buttons by function, so the mapping follows the button's label
           on any model (SpaceMouse Pro Wireless, Enterprise, ...). -->
      <ButtonBank Default="true">
        <Name>STR_DEFAULT_BUTTONBANK</Name>
        <ID>Default</ID>
        <Button>
          <Input>
            <ActionID>V3DK_MENU</ActionID>
          </Input>
          <Output>
            <ActionID>RadialMenu_MenuRM_be77abb0-db47-4f95-85e3-a7c13838ba9d</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>V3DK_FIT</ActionID>
          </Input>
          <Output>
            <ActionID>PC-DMIS Scale to Fit</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>V3DK_1</ActionID>
          </Input>
          <Output>
            <ActionID>PC-DMIS Translate Mode</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>V3DK_2</ActionID>
          </Input>
          <Output>
            <ActionID>PC-DMIS Draw Probe Path</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>V3DK_3</ActionID>
          </Input>
          <Output>
            <ActionID>Driver_ToggleDominantFilter</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>V3DK_4</ActionID>
          </Input>
          <Output>
            <ActionID>Driver_ShowDriverGUI</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>V3DK_ESC</ActionID>
          </Input>
          <Output>
            <ActionID>KB_Esc</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>V3DK_ALT</ActionID>
          </Input>
          <Output>
            <ActionID>KB_Alt</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>V3DK_SHIFT</ActionID>
          </Input>
          <Output>
            <ActionID>KB_Shift</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>V3DK_CTRL</ActionID>
          </Input>
          <Output>
            <ActionID>KB_Ctrl</ActionID>
          </Output>
        </Button>
      </ButtonBank>
    </Device>
    <!-- SpaceMouse Wireless, cabled (256F:C62E) and via its receiver
         (256F:C62F): left button = radial menu, right button = Scale to Fit. -->
    <Device>
      <Name>SpaceMouse Wireless</Name>
      <VendorID>256f</VendorID>
      <ProductID>c62e</ProductID>
      <InheritsFrom>Standard 3D Mouse</InheritsFrom>
      <CurrentButtonBank>Default</CurrentButtonBank>
      <ButtonBank Default="true">
        <Name>STR_DEFAULT_BUTTONBANK</Name>
        <ID>Default</ID>
        <Button>
          <Input>
            <ActionID>HIDButton_1</ActionID>
          </Input>
          <Output>
            <ActionID>RadialMenu_MenuRM_be77abb0-db47-4f95-85e3-a7c13838ba9d</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>HIDButton_2</ActionID>
          </Input>
          <Output>
            <ActionID>PC-DMIS Scale to Fit</ActionID>
          </Output>
        </Button>
      </ButtonBank>
    </Device>
    <Device>
      <Name>SpaceMouse Wireless Receiver</Name>
      <VendorID>256f</VendorID>
      <ProductID>c62f</ProductID>
      <InheritsFrom>Standard 3D Mouse</InheritsFrom>
      <CurrentButtonBank>Default</CurrentButtonBank>
      <ButtonBank Default="true">
        <Name>STR_DEFAULT_BUTTONBANK</Name>
        <ID>Default</ID>
        <Button>
          <Input>
            <ActionID>HIDButton_1</ActionID>
          </Input>
          <Output>
            <ActionID>RadialMenu_MenuRM_be77abb0-db47-4f95-85e3-a7c13838ba9d</ActionID>
          </Output>
        </Button>
        <Button>
          <Input>
            <ActionID>HIDButton_2</ActionID>
          </Input>
          <Output>
            <ActionID>PC-DMIS Scale to Fit</ActionID>
          </Output>
        </Button>
      </ButtonBank>
    </Device>
  </Devices>
</AppCfg>
